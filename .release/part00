@@ -0,0 +1,692 @@
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "postgresql"
+  url      = env("DATABASE_URL")
+}
+
+enum Role {
+  ADMIN
+  MANAGER
+  WORKER
+  VET
+  VIEWER
+}
+
+enum Species {
+  CHICKEN
+  CATTLE
+  PIG
+  SHEEP
+  GOAT
+  FISH
+  BEE
+  OTHER
+}
+
+enum BatchStatus {
+  ACTIVE
+  QUARANTINE
+  SOLD
+  FINISHED
+}
+
+enum MovementType {
+  ENTRY
+  EXIT
+  ADJUSTMENT
+}
+
+enum ExpenseStatus {
+  PENDING
+  PAID
+  CANCELLED
+}
+
+enum VaccinationStatus {
+  SCHEDULED
+  APPLIED
+  OVERDUE
+  CANCELLED
+}
+
+enum ProductionType {
+  EGGS
+  MILK
+  MEAT
+  HONEY
+  FISH
+  MANURE
+  OTHER
+}
+
+enum EggGrade {
+  MIXED
+  JUMBO
+  EXTRA
+  LARGE
+  MEDIUM
+  SMALL
+  BROKEN
+  DIRTY
+  DISCARDED
+}
+
+enum HealthEventType {
+  MEDICATION
+  DISEASE
+  EXAM
+  CLEANING
+  PEST_CONTROL
+  SUPPLEMENT
+  OTHER
+}
+
+enum PurchaseStatus {
+  DRAFT
+  ORDERED
+  RECEIVED
+  CANCELLED
+}
+
+enum SaleStatus {
+  QUOTE
+  CONFIRMED
+  DELIVERED
+  CANCELLED
+}
+
+enum PaymentStatus {
+  PENDING
+  PARTIAL
+  PAID
+  OVERDUE
+  CANCELLED
+}
+
+enum MaintenanceStatus {
+  OPEN
+  IN_PROGRESS
+  COMPLETED
+  CANCELLED
+}
+
+model Farm {
+  id                          String                @id @default(cuid())
+  name                        String
+  document                    String?
+  city                        String?
+  state                       String?
+  phone                       String?
+  email                       String?
+  address                     String?
+  timezone                    String                @default("America/Fortaleza")
+  mortalityAlertPercent       Float                 @default(0.5)
+  productionDropAlertPercent  Float                 @default(10)
+  createdAt                   DateTime              @default(now())
+  updatedAt                   DateTime              @updatedAt
+  users                       User[]
+  houses                      House[]
+  suppliers                   Supplier[]
+  customers                   Customer[]
+  expenseCategories           ExpenseCategory[]
+  expenses                    Expense[]
+  inventoryItems              InventoryItem[]
+  inventoryMovements          InventoryMovement[]
+  purchases                   Purchase[]
+  batches                     LivestockBatch[]
+  animals                     Animal[]
+  dailyFlockRecords           DailyFlockRecord[]
+  eggCollections              EggCollection[]
+  vaccines                    Vaccine[]
+  vaccinations                Vaccination[]
+  healthEvents                HealthEvent[]
+  productionRecords           ProductionRecord[]
+  sales                       Sale[]
+  tasks                       Task[]
+  maintenances                Maintenance[]
+  biosecurityVisits           BiosecurityVisit[]
+  environmentReadings         EnvironmentReading[]
+  documents                   DocumentRecord[]
+  auditLogs                   AuditLog[]
+}
+
+model User {
+  id           String   @id @default(cuid())
+  farmId       String
+  name         String
+  email        String   @unique
+  passwordHash String
+  role         Role     @default(WORKER)
+  active       Boolean  @default(true)
+  createdAt    DateTime @default(now())
+  updatedAt    DateTime @updatedAt
+  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  auditLogs    AuditLog[]
+
+  @@index([farmId])
+}
+
+model House {
+  id          String   @id @default(cuid())
+  farmId      String
+  name        String
+  code        String
+  capacity    Int
+  housingType String?
+  location    String?
+  active      Boolean  @default(true)
+  notes       String?
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  batches     LivestockBatch[]
+  dailyRecords DailyFlockRecord[]
+  eggCollections EggCollection[]
+  environmentReadings EnvironmentReading[]
+
+  @@unique([farmId, code])
+  @@index([farmId, active])
+}
+
+model Supplier {
+  id            String    @id @default(cuid())
+  farmId        String
+  name          String
+  document      String?
+  category      String?
+  contactName   String?
+  phone         String?
+  email         String?
+  address       String?
+  city          String?
+  state         String?
+  notes         String?
+  active        Boolean   @default(true)
+  createdAt     DateTime  @default(now())
+  updatedAt     DateTime  @updatedAt
+  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  expenses      Expense[]
+  purchases     Purchase[]
+  maintenances  Maintenance[]
+
+  @@index([farmId, name])
+}
+
+model Customer {
+  id          String   @id @default(cuid())
+  farmId      String
+  name        String
+  document    String?
+  contactName String?
+  phone       String?
+  email       String?
+  address     String?
+  city        String?
+  state       String?
+  priceTable  String?
+  notes       String?
+  active      Boolean  @default(true)
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  sales       Sale[]
+
+  @@index([farmId, name])
+}
+
+model ExpenseCategory {
+  id        String    @id @default(cuid())
+  farmId    String
+  name      String
+  color     String?
+  createdAt DateTime  @default(now())
+  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  expenses  Expense[]
+
+  @@unique([farmId, name])
+}
+
+model Expense {
+  id            String            @id @default(cuid())
+  farmId        String
+  supplierId    String?
+  categoryId    String?
+  description   String
+  amount        Decimal           @db.Decimal(14, 2)
+  competence    DateTime?
+  dueDate       DateTime?
+  paidAt        DateTime?
+  status        ExpenseStatus     @default(PENDING)
+  paymentMethod String?
+  documentUrl   String?
+  notes         String?
+  createdAt     DateTime          @default(now())
+  updatedAt     DateTime          @updatedAt
+  farm          Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  supplier      Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
+  category      ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
+
+  @@index([farmId, status, dueDate])
+  @@index([farmId, competence])
+}
+
+model InventoryItem {
+  id             String              @id @default(cuid())
+  farmId         String
+  name           String
+  category       String
+  unit           String
+  currentStock   Float               @default(0)
+  minimumStock   Float               @default(0)
+  unitCost       Decimal             @default(0) @db.Decimal(14, 4)
+  lotNumber      String?
+  expiresAt      DateTime?
+  location       String?
+  active         Boolean             @default(true)
+  createdAt      DateTime            @default(now())
+  updatedAt      DateTime            @updatedAt
+  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  movements      InventoryMovement[]
+  purchaseItems  PurchaseItem[]
+
+  @@index([farmId, category])
+}
+
+model InventoryMovement {
+  id             String        @id @default(cuid())
+  farmId         String
+  itemId         String
+  type           MovementType
+  quantity       Float
+  unitCost       Decimal?      @db.Decimal(14, 4)
+  reason         String?
+  documentNumber String?
+  date           DateTime      @default(now())
+  createdAt      DateTime      @default(now())
+  farm           Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
+
+  @@index([farmId, date])
+  @@index([itemId])
+}
+
+model Purchase {
+  id            String         @id @default(cuid())
+  farmId        String
+  supplierId    String
+  date          DateTime
+  invoiceNumber String?
+  status        PurchaseStatus @default(DRAFT)
+  totalValue    Decimal        @default(0) @db.Decimal(14, 2)
+  dueDate       DateTime?
+  receivedAt    DateTime?
+  notes         String?
+  createdAt     DateTime       @default(now())
+  updatedAt     DateTime       @updatedAt
+  farm          Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
+  items         PurchaseItem[]
+
+  @@index([farmId, date, status])
+}
+
+model PurchaseItem {
+  id              String        @id @default(cuid())
+  purchaseId      String
+  inventoryItemId String?
+  description     String
+  quantity        Float
+  unit            String
+  unitCost        Decimal       @db.Decimal(14, 4)
+  totalValue      Decimal       @db.Decimal(14, 2)
+  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
+  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
+
+  @@index([purchaseId])
+}
+
+model LivestockBatch {
+  id                String             @id @default(cuid())
+  farmId            String
+  houseId           String?
+  name               String
+  species            Species
+  breed              String?
+  purpose            String?
+  source              String?
+  initialQuantity     Int
+  currentQuantity     Int
+  entryDate           DateTime
+  hatchDate           DateTime?
+  targetEndDate       DateTime?
+  averageWeight       Float?
+  location            String?
+  status              BatchStatus      @default(ACTIVE)
+  purchaseValue       Decimal?          @db.Decimal(14, 2)
+  notes               String?
+  createdAt           DateTime          @default(now())
+  updatedAt           DateTime          @updatedAt
+  farm                Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  house               House?            @relation(fields: [houseId], references: [id], onDelete: SetNull)
+  animals             Animal[]
+  dailyRecords        DailyFlockRecord[]
+  eggCollections      EggCollection[]
+  vaccinations        Vaccination[]
+  healthEvents        HealthEvent[]
+  productionRecords   ProductionRecord[]
+  sales               Sale[]
+
+  @@index([farmId, status, species])
+  @@index([houseId])
+}
+
+model Animal {
+  id             String          @id @default(cuid())
+  farmId         String
+  batchId        String?
+  identification String
+  species        Species
+  breed          String?
+  sex            String?
+  birthDate      DateTime?
+  weight         Float?
+  status         String          @default("ACTIVE")
+  notes          String?
+  createdAt      DateTime        @default(now())
+  updatedAt      DateTime        @updatedAt
+  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  batch          LivestockBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
+
+  @@unique([farmId, identification])
+  @@index([farmId, species])
+}
+
+model DailyFlockRecord {
+  id               String          @id @default(cuid())
+  farmId           String
+  batchId         