+export function GenericModule({config,session}:{config:ModuleConfig;session:Session}){const[data,setData]=useState<ApiList>({items:[],total:0,page:1,pageSize:25,pages:1}),[search,setSearch]=useState(''),[open,setOpen]=useState(false),[editing,setEditing]=useState<Record<string,unknown>|null>(null),[form,setForm]=useState<Record<string,unknown>>(()=>initial(config)),[error,setError]=useState(''),[busy,setBusy]=useState(false);const canWrite=!config.writeRoles||config.writeRoles.includes(session.user.role);const url=useMemo(()=>`${config.endpoint}?pageSize=100${search?`&search=${encodeURIComponent(search)}`:''}`,[config.endpoint,search]);async function load(){try{setData(await request<ApiList>(url,session));setError('')}catch(e){setError(e instanceof Error?e.message:'Falha ao carregar.')}}useEffect(()=>{void load()},[url]);function create(){setEditing(null);setForm(initial(config));setOpen(true)}function edit(row:Record<string,unknown>){setEditing(row);setForm(normalize(row));setOpen(true)}async function save(e:FormEvent){e.preventDefault();setBusy(true);try{await request(editing?`${config.endpoint}/${editing.id}`:config.endpoint,session,{method:editing?'PUT':'POST',body:JSON.stringify(form)});setOpen(false);await load()}catch(e){setError(e instanceof Error?e.message:'Não foi possível salvar.')}finally{setBusy(false)}}async function remove(row:Record<string,unknown>){if(!confirm(`Excluir ${String(row.title??row.name??'registro')}?`))return;try{await request(`${config.endpoint}/${row.id}`,session,{method:'DELETE'});await load()}catch(e){setError(e instanceof Error?e.message:'Não foi possível excluir.')}}return <><header className="page-header"><div><small>{config.group}</small><h1>{config.title}</h1><p>{config.description}</p></div>{canWrite&&<button className="primary" onClick={create}><Plus size={18}/>Novo registro</button>}</header>{error&&<div className="alert error">{error}</div>}<section className="card table-card"><div className="toolbar"><div className="search"><Search size={18}/><input placeholder="Pesquisar..." value={search} onChange={e=>setSearch(e.target.value)}/></div><span>{data.total} registro(s)</span></div><div className="table-wrap"><table><thead><tr>{config.columns?.map(column=><th key={column.key}>{column.label}</th>)}{canWrite&&<th>Ações</th>}</tr></thead><tbody>{data.items.map(row=><tr key={String(row.id)}>{config.columns?.map(column=><td key={column.key}>{column.format==='status'?<span className={`status status-${String(get(row,column.key)).toLowerCase()}`}>{format(get(row,column.key))}</span>:format(get(row,column.key),column.format)}</td>)}{canWrite&&<td><div className="row-actions"><button onClick={()=>edit(row)} title="Editar"><Edit3 size={17}/></button><button onClick={()=>void remove(row)} title="Excluir"><Trash2 size={17}/></button></div></td>}</tr>)}{!data.items.length&&<tr><td colSpan={(config.columns?.length??0)+1}><div className="empty">Nenhum registro encontrado.</div></td></tr>}</tbody></table></div></section>{open&&<Modal title={editing?`Editar — ${config.title}`:`Novo — ${config.title}`} onClose={()=>setOpen(false)} footer={<><button className="secondary" onClick={()=>setOpen(false)}>Cancelar</button><button className="primary" form="entry-form" disabled={busy}>{busy?'Salvando...':'Salvar'}</button></>}><form id="entry-form" onSubmit={save}><Fields fields={config.fields??[]} form={form} setForm={setForm} session={session}/></form></Modal>}</>}
