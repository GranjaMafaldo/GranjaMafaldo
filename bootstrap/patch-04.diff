+export function Login({onLogin}:{onLogin:(session:Session)=>void}){const[email,setEmail]=useState('admin@granjamafaldo.com.br'),[password,setPassword]=useState(''),[error,setError]=useState(''),[busy,setBusy]=useState(false);async function submit(e:FormEvent){e.preventDefault();setBusy(true);setError('');try{onLogin(await request<Session>('/auth/login',undefined,{method:'POST',body:JSON.stringify({email,password})}))}catch(e){setError(e instanceof Error?e.message:'Não foi possível entrar.')}finally{setBusy(false)}}return <main className="login-page"><section className="login-visual"><img src="/logo-wordmark.svg" alt="Granja Mafaldo"/><div><span className="eyebrow"><Egg size={17}/>Produção com rastreabilidade</span><h1>Da granja ao resultado, tudo sob controle.</h1><p>Acompanhe aves, ovos, sanidade, estoque, vendas e finanças em uma única plataforma.</p></div><small>Granja Mafaldo · Produtos do Campo</small></section><section className="login-panel"><form onSubmit={submit}><img className="mobile-logo" src="/logo-wordmark.svg"/><h2>Acessar a plataforma</h2><p>Entre com seu usuário para continuar.</p>{error&&<div className="alert error">{error}</div>}<label><span>E-mail</span><div className="input-icon"><Mail size={18}/><input type="email" value={email} onChange={e=>setEmail(e.target.value)} required/></div></label><label><span>Senha</span><div className="input-icon"><LockKeyhole size={18}/><input type="password" value={password} onChange={e=>setPassword(e.target.value)} required/></div></label><button className="primary wide" disabled={busy}>{busy?'Entrando...':'Entrar'}</button><small>Use a senha configurada no seed inicial.</small></form></section></main>}
