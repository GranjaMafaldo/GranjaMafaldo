+export function Layout({session,active,onNavigate,onLogout,children}:{session:Session;active:string;onNavigate:(key:string)=>void;onLogout:()=>void;children:ReactNode}){const[menu,setMenu]=useState(false),[profile,setProfile]=useState(false),[online,setOnline]=useState(navigator.onLine);useEffect(()=>{const yes=()=>setOnline(true),no=()=>setOnline(false);addEventListener('online',yes);addEventListener('offline',no);return()=>{removeEventListener('online',yes);removeEventListener('offline',no)}},[]);const visible=modules.filter(module=>module.key!=='settings'||['ADMIN','MANAGER'].includes(session.user.role));const current=visible.find(module=>module.key===active);function go(key:string){onNavigate(key);setMenu(false)}const mobile=['dashboard','egg-collections','daily-records','inventory-items','sales'];return <div className="shell"><aside className={`sidebar ${menu?'open':''}`}><div className="brand"><img src="/logo-wordmark.svg"/><button className="icon-button mobile-only" onClick={()=>setMenu(false)}><Icons.X/></button></div><nav>{groups.map(group=>{const entries=visible.filter(module=>module.group===group);return entries.length?<section key={group}><h3>{group}</h3>{entries.map(module=>{const Icon=icon(module.icon);return <button className={active===module.key?'active':''} key={module.key} onClick={()=>go(module.key)}><Icon size={19}/><span>{module.shortTitle??module.title}</span></button>})}</section>:null})}</nav><div className="sidebar-foot"><img src="/logo-mark.svg"/><span><b>Produtos do campo</b><small>Gestão e qualidade</small></span></div></aside>{menu&&<div className="overlay" onClick={()=>setMenu(false)}/>}<div className="main"><header className="topbar"><div><button className="icon-button menu-button" onClick={()=>setMenu(true)}><Icons.Menu/></button><span><small>{current?.group??'Granja Mafaldo'}</small><b>{current?.shortTitle??current?.title??'Painel'}</b></span></div><div className="top-actions"><i className={`online ${online?'yes':''}`}/><button clas