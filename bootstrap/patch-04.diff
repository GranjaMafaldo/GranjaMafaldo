+function format(value:unknown,type?:string){if(value==null||value==='')return'—';if(type==='money')return Number(value).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});if(type==='number')return Number(value).toLocaleString('pt-BR');if(type==='boolean')return value?'Sim':'Não';if(type==='date'||type==='datetime'){const date=new Date(String(value));return Number.isNaN(date.getTime())?'—':type==='date'?date.toLocaleDateString('pt-BR'):date.toLocaleString('pt-BR')}return String(value).replaceAll('_',' ')}
