@@ -0,0 +1,76 @@
+import { Router, type Response } from 'express';
+import { prisma } from '../prisma';
+
+export const reportsRouter = Router();
+
+function csv(res: Response, name: string, rows: Record<string, unknown>[]) {
+  const keys = [...new Set(rows.flatMap(Object.keys))];
+  const quote = (value: unknown) => `"${String(value ?? '').replaceAll('"', '""')}"`;
+  const body = [
+    keys.join(';'),
+    ...rows.map((row) => keys.map((key) => quote(row[key])).join(';'))
+  ].join('\n');
+
+  res.setHeader('Content-Type', 'text/csv; charset=utf-8');
+  res.setHeader('Content-Disposition', `attachment; filename="${name}.csv"`);
+  res.send(`\ufeff${body}`);
+}
+
+reportsRouter.get('/:report', async (req, res) => {
+  const farmId = req.auth!.farmId;
+  const report = req.params.report;
+
+  if (report === 'production') {
+    const items = await prisma.entry.findMany({
+      where: { farmId, module: { in: ['daily-records', 'egg-collections'] } },
+      orderBy: { date: 'desc' },
+      take: 5000
+    });
+    return csv(res, 'producao', items.map((item) => ({
+      modulo: item.module,
+      data: item.date?.toISOString(),
+      titulo: item.title,
+      quantidade: item.quantity,
+      status: item.status,
+      ...(item.data as Record<string, unknown>)
+    })));
+  }
+
+  if (report === 'financial') {
+    const [sales, expenses] = await Promise.all([
+      prisma.sale.findMany({ where: { farmId }, orderBy: { date: 'desc' }, take: 5000 }),
+      prisma.entry.findMany({ where: { farmId, module: 'expenses' }, orderBy: { date: 'desc' }, take: 5000 })
+    ]);
+    return csv(res, 'financeiro', [
+      ...sales.map((sale) => ({
+        tipo: 'RECEITA',
+        data: sale.date.toISOString(),
+        descricao: sale.customerName,
+        valor: sale.totalAmount,
+        status: sale.status
+      })),
+      ...expenses.map((expense) => ({
+        tipo: 'DESPESA',
+        data: expense.date?.toISOString(),
+        descricao: expense.title,
+        valor: expense.amount,
+        status: expense.status
+      }))
+    ]);
+  }
+
+  if (report === 'flocks') {
+    const items = await prisma.entry.findMany({
+      where: { farmId, module: 'flocks' },
+      orderBy: { createdAt: 'desc' }
+    });
+    return csv(res, 'lotes', items.map((item) => ({
+      lote: item.title,
+      aves: item.quantity,
+      status: item.status,
+      ...(item.data as Record<string, unknown>)
+    })));
+  }
+
+  res.status(404).json({ message: 'Relatório não encontrado.' });
+});
