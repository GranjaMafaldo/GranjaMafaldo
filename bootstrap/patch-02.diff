+import { Router } from 'express';
+import { z } from 'zod';
+import { audit } from '../audit';
+import { canWrite } from '../auth';
+import { prisma } from '../prisma';
+export const salesRouter = Router();
+
+const item=z.object({productId:z.string().optional().nullable(),sourceLotId:z.string().optional().nullable(),description:z.string().min(1),quantity:z.coerce.number().positive(),unit:z.string().min(1),unitPrice:z.coerce.number().nonnegative()});
+const sale=z.object({customerId:z.string().optional().nullable(),customerName:z.string().min(1),date:z.coerce.date(),deliveryDate:z.coerce.date().optional().nullable(),status:z.string().default('PENDING'),paymentMethod:z.string().optional().nullable(),discount:z.coerce.number().nonnegative().default(0),deliveryFee:z.coerce.number().nonnegative().default(0),receivedAmount:z.coerce.number().nonnegative().default(0),deliveryAddress:z.string().optional().nullable(),notes:z.string().optional().nullable(),items:z.array(item).min(1)});
+async function validateRefs(farmId:string,data:z.infer<typeof sale>){
+  if(data.customerId&&!await prisma.entry.findFirst({where:{id:data.customerId,farmId,module:'customers'}})) return 'Cliente inválido.';
+  for(const row of data.items){if(row.productId&&!await prisma.entry.findFirst({where:{id:row.productId,farmId,module:'products'}}))return 'Produto inválido.';if(row.sourceLotId&&!await prisma.entry.findFirst({where:{id:row.sourceLotId,farmId,module:'flocks'}}))return 'Lote de origem inválido.';} return null;
+}
+
+salesRouter.get('/',async(req,res)=>{const page=Math.max(1,Number(req.query.page??1)),pageSize=Math.min(100,Math.max(1,Number(req.query.pageSize??25))),where={farmId:req.auth!.farmId};const[items,total]=await Promise.all([prisma.sale.findMany({where,include:{items:true,payments:true},orderBy:{date:'desc'},skip:(page-1)*pageSize,take:pageSize}),prisma.sale.count({where})]);res.json({items,total,page,pageSize,pages:Math.max(1,Math.ceil(total/pageSize))})});
+salesRouter.post('/',async(req,res)=>{if(!canWrite(req.auth!.role,'sales'))return void res.status(403).json({message:'Seu perfil não permite registrar vendas.'});const parsed=sale.safeParse(req.body);if(!parsed.success)return void res.status(400).json({message:parsed.error.issues[0]?.message??'Dados inválidos.'});const invalid=await validateRefs(req.auth!.farmId,parsed.data);if(invalid)return void res.status(400).json({message:invalid});const{items,...header}=parsed.data,subtotal=items.reduce((s,row)=>s+row.quantity*row.unitPrice,0),totalAmount=Math.max(0,subtotal-header.discount+header.deliveryFee);const created=await prisma.sale.create({data:{...header,farmId:req.auth!.farmId,subtotal,totalAmount,status:header.receivedAmount>=totalAmount?'PAID':header.status,items:{create:items.map(row=>({...row,totalAmount:row.quantity*row.unitPrice}))}},include:{items:true,payments:true}});await audit(req,'CREATE','sales',created.id,parsed.data);res.status(201).json(created)});
+salesRouter.put('/:id',async(req,res)=>{if(!canWrite(req.auth!.role,'sales'))return void res.status(403).json({message:'Seu perfil não permite editar vendas.'});const parsed=sale.safeParse(req.body);if(!parsed.success)return void res.status(400).json({message:parsed.error.issues[0]?.message??'Dados inválidos.'});const old=await prisma.sale.findFirst({where:{id:req.params.id,farmId:req.auth!.farmId}});if(!old)return void res.status(404).json({message:'Venda não encontrada.'});const invalid=await validateRefs(req.auth!.farmId,parsed.data);if(invalid)return void res.status(400).json({message:invalid});const{items,...header}=parsed.data,subtotal=items.reduce((s,row)=>s+row.quantity*row.unitPrice,0),totalAmount=Math.max(0,subtotal-header.discount+header.deliveryFee);const updated=await prisma.sale.update({where:{id:old.id},data:{...header,subtotal,totalAmount,status:header.receivedAmount>=totalAmount?'PAID':header.status,items:{deleteMany:{},create:items.map(row=>({...row,totalAmount:row.quantity*row.unitPrice}))}},include:{items:true,payments:true}});await audit(req,'UPDATE','sales',updated.id,parsed.data);res.json(updated)});
+salesRouter.post('/:id/payments',async(req,res)=>{if(!canWrite(req.auth!.role,'sales'))return void res.status(403).json({message:'Seu perfil não permite registrar recebimentos.'});const parsed=z.object({date:z.coerce.date(),amount:z.coerce.number().positive(),method:z.string().optional().nullable(),reference:z.string().optional().nullable(),notes:z.string().optional().nullable()}).safeParse(req.body);if(!parsed.success)return void res.status(400).json({message:'Dados de pagamento inválidos.'});const current=await prisma.sale.findFirst({where:{id:req.params.id,farmId:req.auth!.farmId}});if(!current)return void res.status(404).json({message:'Venda não encontrada.'});const result=await prisma.$transaction(async tx=>{const payment=await tx.payment.create({data:{saleId:current.id,...parsed.data}});const receivedAmount=Number(current.receivedAmount)+parsed.data.amount;const sale=await tx.sale.update({where:{id:current.id},data:{receivedAmount,status:receivedAmount>=Number(current.totalAmount)?'PAID':current.status}});return{payment,sale}});await audit(req,'CREATE','payments',result.payment.id,parsed.data);res.status(201).json(result)});
+salesRouter.delete('/:id',async(req,res)=>{if(!['ADMIN','MANAGER'].includes(req.auth!.role))return void res.status(403).json({message:'Somente gestores podem excluir vendas.'});const old=await prisma.sale.findFirst({where:{id:req.params.id,farmId:req.auth!.farmId}});if(!old)return void res.status(404).json({message:'Venda não encontrada.'});await prisma.sale.delete({where:{id:old.id}});await audit(req,'DELETE','sales',old.id);res.status(204).send()});
