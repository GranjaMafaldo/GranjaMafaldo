+import{useEffect,useState,type ReactNode}from'react';import{Bird,Egg,HandCoins,PackageSearch,Scale,TrendingUp,Wheat}from'lucide-react';import{request}from'../api';import type{Session}from'../types';
+type Entry={id:string;title:string;date?:string;status?:string;quantity?:number;data?:Record<string,unknown>};type Stock={id:string;name:string;currentStock:number;minimumStock:number;unit:string;expiresAt?:string};type Data={kpis:{birds:number;totalEggs:number;layRate:number;feedKg:number;mortality:number;revenue:number;expenses:number;result:number};flocks:Entry[];stock:Stock[];vaccinations:Entry[];tasks:Entry[]};const money=(v:number)=>v.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});function Kpi({label,value,icon}:{label:string;value:ReactNode;icon:ReactNode}){return <article className="kpi"><span>{icon}</span><div><small>{label}</small><strong>{value}</strong></div></article>}function List({title,children}:{title:string;children:ReactNode}){return <article className="card panel"><h3>{title}</h3>{children}</article>}
+export function Dashboard({session,onNavigate}:{session:Session;onNavigate:(key:string)=>void}){const[data,setData]=useState<Data|null>(null),[error,setError]=useState('');useEffect(()=>{request<Data>('/dashboard',session).then(setData).catch(e=>setError(e instanceof Error?e.message:'Falha ao carregar.'))},[session]);if(error)return <div className="alert error">{error}</div>;if(!data)return <div className="loading">Carregando painel...</div>;return <><section className="hero"><div><small>GRANJA MAFALDO</small><h1>Bom trabalho, {session.user.name.split(' ')[0]}!</h1><p>Acompanhe os principais indicadores da operação de hoje.</p><button onClick={()=>onNavigate('egg-collections')}>Registrar produção</button></div><img src="/logo-mark.svg"/></section><section className="kpi-grid"><Kpi label="Aves ativas" value={data.kpis.birds.toLocaleString('pt-BR')} icon={<Bird/>}/><Kpi label="Ovos hoje" value={data.kpis.totalEggs.toLocaleString('pt-BR')} icon={<Egg/>}/><Kpi label="Taxa de postura" value={`${data.kpis.layRate}%`} icon={<TrendingUp/>}/><Kpi label="Ração hoje" value={`${data.kpis.feedKg} kg`} icon={<Wheat/>}/><Kpi label="Receita no mês" value={money(data.kpis.revenue)} icon={<HandCoins/>}/><Kpi label="Resultado no mês" value={money(data.kpis.result)} icon={<Scale/>}/></section><section className="dashboard-grid"><List title="Lotes ativos">{data.flocks.length?data.flocks.map(item=><button className="list-row" key={item.id} onClick={()=>onNavigate('flocks')}><span><b>{item.title}</b><small>{String(item.data?.breed??'Linhagem não informada')}</small></span><strong>{Number(item.quantity??0).toLocaleString('pt-BR')} aves</strong></button>):<p className="empty">Nenhum lote ativo.</p>}</List><List title="Estoque prioritário">{data.stock.length?data.stock.map(item=><button className={`list-row ${Number(item.currentStock)<=Number(item.minimumStock)?'warning':''}`} key={item.id} onClick={()=>onNavigate('inventory-items')}><span><b>{item.name}</b><small>Mínimo: {Number(item.minimumStock)} {item.unit}</small></span><strong>{Number(item.currentStock)} {item.unit}</strong></button>):<p className="empty">Nenhum item cadastrado.</p>}</List><List title="Próximas vacinações">{data.vaccinations.length?data.vaccinations.map(item=><button className="list-row" key={item.id} onClick={()=>onNavigate('vaccinations')}><span><b>{item.title}</b><small>{item.date?new Date(item.date).toLocaleDateString('pt-BR'):'Sem data'}</small></span><i className="status status-pending">{item.status}</i></button>):<p className="empty">Nenhuma vacinação pendente.</p>}</List><List title="Tarefas abertas">{data.tasks.length?data.tasks.map(item=><button className="list-row" key={item.id} onClick={()=>onNavigate('tasks')}><span><b>{item.title}</b><small>{item.date?new Date(item.date).toLocaleString('pt-BR'):'Sem prazo'}</small></span><i className="status status-active">{item.status}</i></button>):<p className="empty">Nenhuma tarefa aberta.</p>}</List></section><section className="quick"><h2>Acesso rápido</h2><div><button onClick={()=>onNavigate('daily-records')}><Bird/>Ficha diária</button><button onClick={()=>onNavigate('egg-collections')}><Egg/>Coleta de ovos</button><button onClick={()=>onNavigate('inventory-movements')}><PackageSearch/>Movimentar estoque</button></div></section></>}
