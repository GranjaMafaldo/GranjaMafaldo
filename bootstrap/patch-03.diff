+import{useEffect,useState}from'react';import{request}from'./api';import{moduleMap}from'./modules';import type{Session}from'./types';import{Dashboard}from'./components/Dashboard';import{GenericModule}from'./components/GenericModule';import{Layout}from'./components/Layout';import{Login}from'./components/Login';import{ReportsPage}from'./components/ReportsPage';import{SalesPage}from'./components/SalesPage';import{SettingsPage}from'./components/SettingsPage';
+const STORAGE='granja-mafaldo-session';
+export default function App(){const[session,setSession]=useState<Session|null>(()=>{try{return JSON.parse(localStorage.getItem(STORAGE)??'null')}catch{return null}}),[active,setActive]=useState(()=>location.hash.slice(1)||'dashboard'),[checking,setChecking]=useState(Boolean(session));useEffect(()=>{const handler=()=>setActive(location.hash.slice(1)||'dashboard');addEventListener('hashchange',handler);return()=>removeEventListener('hashchange',handler)},[]);useEffect(()=>{if(!session)return;request('/auth/me',session).then(()=>setChecking(false)).catch(()=>{localStorage.removeItem(STORAGE);setSession(null);setChecking(false)})},[]);function login(value:Session){localStorage.setItem(STORAGE,JSON.stringify(value));setSession(value);setChecking(false)}function update(value:Session){localStorage.setItem(STORAGE,JSON.stringify(value));setSession(value)}function logout(){localStorage.removeItem(STORAGE);setSession(null);location.hash=''}function navigate(key:string){location.hash=key;setActive(key)}if(checking)return <div className="splash"><img src="/logo-wordmark.svg"/><span>Carregando...</span></div>;if(!session)return <Login onLogin={login}/>;const config=moduleMap[active]??moduleMap.dashboard!;let page;if(active==='dashboard')page=<Dashboard session={session} onNavigate={navigate}/>;else if(config.kind==='sales')page=<SalesPage session={session}/>;else if(config.kind==='reports')page=<ReportsPage session={session}/>;else if(config.kind==='settings')page=<SettingsPage session={session} setSession={update}/>;else page=<GenericModule config={config} session={session}/>;return <Layout session={session} active={active} onNavigate={navigate} onLogout={logout}>{page}</Layout>}
