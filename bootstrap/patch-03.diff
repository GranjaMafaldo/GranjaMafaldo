+import{useEffect,useState}from'react';import{request}from'../api';import type{Field,Session}from'../types';
+function get(obj:Record<string,unknown>,path:string){return path.split('.').reduce<unknown>((value,key)=>value&&typeof value==='object'?(value as Record<string,unknown>)[key]:undefined,obj)}
+export function setPath(obj:Record<string,unknown>,path:string,value:unknown){const keys=path.split('.'),copy=structuredClone(obj),last=keys.pop()!;let cursor=copy;for(const key of keys){if(!cursor[key]||typeof cursor[key]!=='object')cursor[key]={};cursor=cursor[key] as Record<string,unknown>}cursor[last]=value;return copy}
+export function FieldControl({field,value,onChange,session}:{field:Field;value:unknown;onChange:(value:unknown)=>void;session:Session}){const[options,setOptions]=useState<{value:string;label:string}[]>(field.options??[]);useEffect(()=>{const endpoint=field.relationEndpoint??(field.relationModule?`/entries/${field.relationModule}?pageSize=100`:undefined);if(!endpoint)return;request<{items:Record<string,unknown>[]}>(endpoint,session).then(data=>setOptions(data.items.map(item=>({value:String(item.id),label:String(item.title??item.name??item.email??item.id)})))).catch(()=>setOptions([]))},[field.relationEndpoint,field.relationModule,session]);const stringValue=value==null?'':String(value);if(field.type==='textarea')return <textarea value={stringValue} required={field.required} onChange={e=>onChange(e.target.value)}/>;if(field.type==='checkbox')return <input className="check" type="checkbox" checked={Boolean(value)} onChange={e=>onChange(e.target.checked)}/>;if(field.type==='select'||field.type==='relation')return <select value={stringValue} required={field.required} onChange={e=>onChange(e.target.value||null)}><option value="">Selecione</option>{options.map(option=><option key={option.value} value={option.value}>{option.label}</option>)}</select>;return <input type={field.type??'text'} step={field.step} value={stringValue} required={field.required} onChange={e=>onChange(field.type==='number'?(e.target.value===''?null:Number(e.target.value)):e.target.value)}/>} 
+export function Fields({fields,form,setForm,session}:{fields:Field[];form:Record<string,unknown>;setForm:(form:Record<string,unknown>)=>void;session:Session}){return <div className="form-grid">{fields.map(field=><label className={field.full?'full':''} key={field.key}><span>{field.label}{field.required&&' *'}</span><FieldControl field={field} value={get(form,field.key)} onChange={value=>setForm(setPath(form,field.key,value))} session={session}/></label>)}</div>}
