+++ b/apps/api/src/routes/entries.ts
@@ -0,0 +1,90 @@
+import { Router } from 'express';
+import { z } from 'zod';
+import { audit } from '../audit';
+import { canWrite } from '../auth';
+import { prisma } from '../prisma';
+export const entriesRouter = Router();
+
+export const modules = ['aviaries','flocks','daily-records','egg-collections','vaccines','vaccinations','health-events','suppliers','customers','products','purchases','expenses','tasks','maintenances','visitors','environment-readings','water-quality','documents'] as const;
+const moduleSet = new Set<string>(modules);
+const payload = z.object({
+  title: z.string().min(1), date: z.coerce.date().optional().nullable(), status: z.string().optional().nullable(),
+  quantity: z.coerce.number().optional().nullable(), amount: z.coerce.number().optional().nullable(),
+  referenceId: z.string().optional().nullable(), data: z.record(z.string(), z.unknown()).default({})
+});
+function validModule(value: string) { return moduleSet.has(value); }
+function num(value: unknown) { const parsed = Number(value ?? 0); return Number.isFinite(parsed) ? parsed : 0; }
+
+async function applyRules(module: string, body: z.infer<typeof payload>, farmId: string) {
+  const data = { ...body.data };
+  if (module === 'daily-records') {
+    const end = data.birdsEnd == null ? num(data.birdsStart) - num(data.mortality) - num(data.culled) : num(data.birdsEnd);
+    if (end < 0) throw new Error('A quantidade final de aves não pode ser negativa.');
+    data.birdsEnd = end; body.quantity = end;
+    if (body.referenceId) await prisma.entry.updateMany({ where: { id: body.referenceId, farmId, module: 'flocks' }, data: { quantity: end } });
+  }
+  if (module === 'egg-collections') {
+    const total = body.quantity ?? num(data.totalEggs);
+    const losses = ['dirty','cracked','broken','discarded'].reduce((sum, key) => sum + num(data[key]), 0);
+    const saleable = data.saleable == null ? Math.max(0, total - losses) : num(data.saleable);
+    if (saleable + losses > total) throw new Error('O total comercializável e as perdas não podem superar o total produzido.');
+    data.totalEggs = total; data.saleable = saleable; body.quantity = total;
+  }
+  if (module === 'vaccinations' && data.appliedDate) body.status = 'COMPLETED';
+  if (body.referenceId) {
+    const reference = await prisma.entry.findFirst({ where: { id: body.referenceId, farmId } });
+    if (!reference) throw new Error('Referência inválida para esta granja.');
+  }
+  return { ...body, data };
+}
+
+entriesRouter.get('/:module', async (req, res) => {
+  const module = req.params.module;
+  if (!validModule(module)) return void res.status(404).json({ message: 'Módulo não encontrado.' });
+  const page = Math.max(1, Number(req.query.page ?? 1));
+  const pageSize = Math.min(100, Math.max(1, Number(req.query.pageSize ?? 25)));
+  const search = String(req.query.search ?? '').trim();
+  const where = { farmId: req.auth!.farmId, module, ...(req.query.status ? { status: String(req.query.status) } : {}), ...(search ? { title: { contains: search, mode: 'insensitive' as const } } : {}) };
+  const [items, total] = await Promise.all([
+    prisma.entry.findMany({ where, orderBy: [{ date: 'desc' }, { createdAt: 'desc' }], skip: (page - 1) * pageSize, take: pageSize }),
+    prisma.entry.count({ where })
+  ]);
+  res.json({ items, total, page, pageSize, pages: Math.max(1, Math.ceil(total / pageSize)) });
+});
+
+entriesRouter.post('/:module', async (req, res) => {
+  const module = req.params.module;
+  if (!validModule(module)) return void res.status(404).json({ message: 'Módulo não encontrado.' });
+  if (!canWrite(req.auth!.role, module)) return void res.status(403).json({ message: 'Seu perfil não permite esta operação.' });
+  const parsed = payload.safeParse(req.body);
+  if (!parsed.success) return void res.status(400).json({ message: parsed.error.issues[0]?.message ?? 'Dados inválidos.' });
+  try {
+    const data = await applyRules(module, parsed.data, req.auth!.farmId);
+    const item = await prisma.entry.create({ data: { ...data, farmId: req.auth!.farmId, module, data: data.data as never } });
+    await audit(req, 'CREATE', module, item.id, data); res.status(201).json(item);
+  } catch (error) { res.status(400).json({ message: error instanceof Error ? error.message : 'Não foi possível salvar.' }); }
+});
+
+entriesRouter.put('/:module/:id', async (req, res) => {
+  const module = req.params.module;
+  if (!validModule(module)) return void res.status(404).json({ message: 'Módulo não encontrado.' });
+  if (!canWrite(req.auth!.role, module)) return void res.status(403).json({ message: 'Seu perfil não permite esta operação.' });
+  const parsed = payload.safeParse(req.body);
+  if (!parsed.success) return void res.status(400).json({ message: parsed.error.issues[0]?.message ?? 'Dados inválidos.' });
+  const current = await prisma.entry.findFirst({ where: { id: req.params.id, farmId: req.auth!.farmId, module } });
+  if (!current) return void res.status(404).json({ message: 'Registro não encontrado.' });
+  try {
+    const data = await applyRules(module, parsed.data, req.auth!.farmId);
+    const item = await prisma.entry.update({ where: { id: current.id }, data: { ...data, data: data.data as never } });
+    await audit(req, 'UPDATE', module, item.id, data); res.json(item);
+  } catch (error) { res.status(400).json({ message: error instanceof Error ? error.message : 'Não foi possível salvar.' }); }
+});
+
+entriesRouter.delete('/:module/:id', async (req, res) => {
+  const module = req.params.module;
+  if (!validModule(module)) return void res.status(404).json({ message: 'Módulo não encontrado.' });
+  if (!canWrite(req.auth!.role, module)) return void res.status(403).json({ message: 'Seu perfil não permite esta operação.' });
+  const item = await prisma.entry.findFirst({ where: { id: req.params.id, farmId: req.auth!.farmId, module } });
+  if (!item) return void res.status(404).json({ message: 'Registro não encontrado.' });
+  await prisma.entry.delete({ where: { id: item.id } }); await audit(req, 'DELETE', module, item.id); res.status(204).send();
+});
