+import type { Request } from 'express';
+import { prisma } from './prisma';
+export async function audit(req: Request, action: string, entity: string, entityId?: string, payload?: unknown) {
+  if (!req.auth) return;
+  await prisma.audit.create({ data: { farmId: req.auth.farmId, userId: req.auth.userId, action, entity, entityId, payload: payload as never, ipAddress: req.ip } });
+}
diff --git a/apps/api/src/auth.ts b/apps/api/src/auth.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9730abaa2f6eccec70090c18d2d983b901aa89a8
--- /dev/null
+++ b/apps/api/src/auth.ts
@@ -0,0 +1,32 @@
+import type { NextFunction, Request, Response } from 'express';
+import type { Role } from '@prisma/client';
+import jwt from 'jsonwebtoken';
+import { env } from './config';
+import { prisma } from './prisma';
+
+type Payload = { sub: string; farmId: string; role: Role };
+export function tokenFor(user: { id: string; farmId: string; role: Role }) {
+  return jwt.sign({ farmId: user.farmId, role: user.role }, env.JWT_SECRET, { subject: user.id, issuer: 'granja-mafaldo', expiresIn: '12h' });
+}
+export async function authenticate(req: Request, res: Response, next: NextFunction) {
+  try {
+    const header = req.headers.authorization;
+    if (!header?.startsWith('Bearer ')) return void res.status(401).json({ message: 'Autenticação necessária.' });
+    const payload = jwt.verify(header.slice(7), env.JWT_SECRET, { issuer: 'granja-mafaldo' }) as Payload;
+    const user = await prisma.user.findFirst({ where: { id: payload.sub, farmId: payload.farmId, active: true }, select: { id: true, farmId: true, role: true, name: true, email: true } });
+    if (!user) return void res.status(401).json({ message: 'Sessão inválida.' });
+    req.auth = { userId: user.id, farmId: user.farmId, role: user.role, name: user.name, email: user.email };
+    next();
+  } catch { res.status(401).json({ message: 'Sessão expirada ou token inválido.' }); }
+}
+export function canWrite(role: Role, module: string) {
+  if (role === 'ADMIN') return true;
+  const permissions: Record<Role, string[]> = {
+    ADMIN: ['*'], MANAGER: ['*'],
+    WORKER: ['aviaries','flocks','daily-records','egg-collections','inventory-items','inventory-movements','tasks','visitors','environment-readings','water-quality'],
+    VET: ['vaccines','vaccinations','health-events','flocks'],
+    FINANCE: ['suppliers','customers','products','purchases','expenses','sales'],
+    VIEWER: []
+  };
+  return permissions[role].includes('*') || permissions[role].includes(module);
+}
