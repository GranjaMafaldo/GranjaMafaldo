diff --git a/apps/api/prisma/schema.prisma b/apps/api/prisma/schema.prisma
new file mode 100644
index 0000000000000000000000000000000000000000..0b1d0eabb184d6f75f6a9479f70e299a66a68dde
--- /dev/null
+++ b/apps/api/prisma/schema.prisma
@@ -0,0 +1,172 @@
+generator client { provider = "prisma-client-js" }
+datasource db { provider = "postgresql" url = env("DATABASE_URL") }
+
+enum Role { ADMIN MANAGER WORKER VET FINANCE VIEWER }
+enum MovementType { ENTRY EXIT ADJUSTMENT }
+
+model Farm {
+  id String @id @default(cuid())
+  name String
+  tradeName String?
+  document String?
+  phone String?
+  email String?
+  address String?
+  city String?
+  state String?
+  postalCode String?
+  timezone String @default("America/Fortaleza")
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  users User[]
+  entries Entry[]
+  inventoryItems InventoryItem[]
+  movements InventoryMovement[]
+  sales Sale[]
+  audits Audit[]
+}
+
+model User {
+  id String @id @default(cuid())
+  farmId String
+  name String
+  email String @unique
+  passwordHash String
+  role Role @default(WORKER)
+  active Boolean @default(true)
+  lastLoginAt DateTime?
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  movements InventoryMovement[]
+  audits Audit[]
+  @@index([farmId, active])
+}
+
+model Entry {
+  id String @id @default(cuid())
+  farmId String
+  module String
+  title String
+  date DateTime?
+  status String?
+  quantity Decimal? @db.Decimal(14, 3)
+  amount Decimal? @db.Decimal(14, 2)
+  referenceId String?
+  data Json @default("{}")
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  @@index([farmId, module, date])
+  @@index([farmId, module, status])
+}
+
+model InventoryItem {
+  id String @id @default(cuid())
+  farmId String
+  name String
+  sku String?
+  category String
+  unit String
+  currentStock Decimal @default(0) @db.Decimal(14, 3)
+  minimumStock Decimal @default(0) @db.Decimal(14, 3)
+  unitCost Decimal? @db.Decimal(14, 4)
+  batchNumber String?
+  expiresAt DateTime?
+  location String?
+  active Boolean @default(true)
+  notes String?
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  movements InventoryMovement[]
+  @@unique([farmId, sku])
+  @@index([farmId, category, active])
+}
+
+model InventoryMovement {
+  id String @id @default(cuid())
+  farmId String
+  inventoryItemId String
+  createdById String?
+  date DateTime
+  type MovementType
+  quantity Decimal @db.Decimal(14, 3)
+  unitCost Decimal? @db.Decimal(14, 4)
+  reason String?
+  document String?
+  notes String?
+  createdAt DateTime @default(now())
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
+  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
+  @@index([farmId, date])
+  @@index([inventoryItemId])
+}
+
+model Sale {
+  id String @id @default(cuid())
+  farmId String
+  customerId String?
+  customerName String
+  date DateTime
+  deliveryDate DateTime?
+  status String @default("PENDING")
+  paymentMethod String?
+  subtotal Decimal @default(0) @db.Decimal(14, 2)
+  discount Decimal @default(0) @db.Decimal(14, 2)
+  deliveryFee Decimal @default(0) @db.Decimal(14, 2)
+  totalAmount Decimal @default(0) @db.Decimal(14, 2)
+  receivedAmount Decimal @default(0) @db.Decimal(14, 2)
+  deliveryAddress String?
+  notes String?
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  items SaleItem[]
+  payments Payment[]
+  @@index([farmId, date])
+  @@index([farmId, status])
+}
+
+model SaleItem {
+  id String @id @default(cuid())
+  saleId String
+  productId String?
+  sourceLotId String?
+  description String
+  quantity Decimal @db.Decimal(14, 3)
+  unit String
+  unitPrice Decimal @db.Decimal(14, 4)
+  totalAmount Decimal @db.Decimal(14, 2)
+  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
+  @@index([saleId])
+}
+
+model Payment {
+  id String @id @default(cuid())
+  saleId String
+  date DateTime
+  amount Decimal @db.Decimal(14, 2)
+  method String?
+  reference String?
+  notes String?
+  createdAt DateTime @default(now())
+  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
+  @@index([saleId, date])
+}
+
+model Audit {
+  id String @id @default(cuid())
+  farmId String
+  userId String?
+  action String
+  entity String
+  entityId String?
+  payload Json?
+  ipAddress String?
+  createdAt DateTime @default(now())
+  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
+  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
+  @@index([farmId, createdAt])
+}
